scratch/
/dist/
/claustrum
/claustrum.exe

# mkdocs build output + local docs toolchain venv
/site/
/.venv/

# Host-local agent guardrails (host specifics + context-mode routing; never committed)
CLAUDE.local.md

# Go build & test artifacts
*.test
*.out
coverage.*
# gotestsum's JUnit output (ci.yml). Matches neither *.out nor coverage.*, so a
# contributor reproducing the CI command locally would otherwise be left with an
# untracked file in the repo root — cf. /remote-server.log below.
/junit.xml

# Daemon runtime artifacts. -serve creates remote-server.log beside the socket,
# and a bare `-serve` in the repo root puts it here. Accidentally committed once
# (0 bytes, in #196) by a `git add -A`.
/remote-server.log
/rpc.sock
/rpc.pipe
/daemon.token

# Python bytecode (the scripts/ upstream-tracking helpers are stdlib Python)
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
.nfs*
